# Copy to .env and fill in. Never commit the real file.
#
#   cp apps/api/.env.example apps/api/.env

# ── Firebase (required) ──────────────────────────────────────────────────────
# The service-account JSON, as a single-line string. Alternatively drop the file
# at apps/api/utils/firebase-service-account.json (already gitignored).
FIREBASE_CREDENTIALS=

FIREBASE_STORAGE_BUCKET=

# ── OpenAI (required for categorize, recipe import, meal suggestions) ────────
OPENAI_API_KEY=

# ── Algolia (required for explore/search and user search) ───────────────────
ALGOLIA_APP_ID=
ALGOLIA_READ_KEY=
ALGOLIA_WRITE_KEY=

# ── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Bun serves on 3000 by default; the Makefile assumes that.
PORT=3000
