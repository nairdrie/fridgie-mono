# Copy to .env and fill in. Never commit the real file.
#
#   cp apps/api/.env.example apps/api/.env

# ── Firebase (required) ──────────────────────────────────────────────────────
# The service-account JSON, as a single-line string. Alternatively drop the file
# at apps/api/utils/firebase-service-account.json (already gitignored).
FIREBASE_CREDENTIALS=

FIREBASE_STORAGE_BUCKET=

# ── Anthropic (required for categorize, recipe import, meal suggestions) ────
ANTHROPIC_API_KEY=

# ── Supadata (optional audio transcription for TikTok and Instagram imports) ─
# Server-only key. Cloud Run reads it from Secret Manager; never expose in Expo.
SUPADATA_API_KEY=

# ── Fridgie Pro / RevenueCat (optional until subscriptions are configured) ──
# Server-side RevenueCat v1 secret key. Never put this key in Expo; the mobile
# app uses RevenueCat's public, platform-specific SDK keys instead.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=fridgie_pro

# Fixed weekly fair-use limits. Free is hard-capped at 10 even if an operator
# accidentally supplies a larger value. Pro defaults to 100 when omitted.
FRIDGIE_FREE_WEEKLY_AI_LIMIT=10
FRIDGIE_PRO_WEEKLY_AI_LIMIT=100
# Pro photo identification is metered separately so a scan followed by a meal
# suggestion does not consume two visible suggestion uses.
FRIDGIE_PRO_WEEKLY_LEFTOVERS_SCAN_LIMIT=50
FRIDGIE_MAX_CONCURRENT_LEFTOVERS_SCANS=1

# Separate non-refundable provider-attempt guards. These fixed UTC-hour caps
# still count failed/empty provider calls when the visible weekly use refunds.
FRIDGIE_SUGGEST_HOURLY_ATTEMPT_LIMIT=20
FRIDGIE_LEFTOVERS_HOURLY_ATTEMPT_LIMIT=8

# How long a successful server verification is reused (60–86400 seconds).
REVENUECAT_CACHE_TTL_SECONDS=900
# ── Fridgie Pro nutrition estimates (optional) ─────────────────────────────
# Keep this false until signed terms approve storage/caching + attribution and
# a provider-side hard monthly spend/request/licensing cap is configured.
# Credentials by themselves do not enable outbound analysis.
NUTRITION_PROVIDER_ENABLED=false
# Server-only Edamam Nutrition Analysis credentials. When disabled or with
# either value absent, goals/cooked status work and nutrient totals are omitted.
EDAMAM_NUTRITION_APP_ID=
EDAMAM_NUTRITION_APP_KEY=

# Per-request burst controls only; these do not bound aggregate provider cost.
NUTRITION_MAX_NEW_ANALYSES_PER_REQUEST=8
NUTRITION_ANALYSIS_CONCURRENCY=2

# ── OpenAI (only scripts/generateRecipePhoto.ts, which generates dish images) ─
OPENAI_API_KEY=

# ── Claude connector (optional) ─────────────────────────────────────────────
# Pins the origin the /mcp OAuth metadata advertises. Unset, it comes from the
# request's forwarded headers. See mcp/README.md.
# PUBLIC_BASE_URL=https://api.fridgie.ca

# ── Printed cookbooks (optional; preview works before commerce setup) ────────
# Keep sandbox during development. Production remains locked unless BOTH
# production flags below are explicitly true and live Stripe keys are present.
LULU_ENV=sandbox
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
LULU_SOFTCOVER_POD_PACKAGE_ID=0700X1000.FC.STD.PB.080CW444.MXX
LULU_HARDCOVER_POD_PACKAGE_ID=0700X1000.FC.STD.CW.080CW444.MXX
# Current Lulu docs disagree on shipping_option vs shipping_level. Leave this
# at the schema value until an authenticated sandbox probe proves otherwise.
LULU_COST_SHIPPING_FIELD=shipping_option
LULU_PRODUCTION_DELAY_MINUTES=1440
# Minimum wait before an ambiguous/expired provider submission may be repeated.
# Exact external-id recovery is always attempted first.
PRINT_AMBIGUOUS_RETRY_MINUTES=15

# Dedicated private bucket recommended. Objects are never made public; Lulu and
# the app receive expiring V4 signed URLs.
PRINT_STORAGE_BUCKET=
PRINT_ORDER_ARTIFACT_RETENTION_DAYS=120
PRINT_REPRINT_EXECUTION_ENABLED=false
PRINT_SUPPORT_EMAIL=support@fridgie.ca
PRINT_MARKUP_BPS=0
PRINT_QUOTE_CURRENCY=CAD

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=false
STRIPE_PRINTED_BOOK_TAX_CODE=txcd_35010000
STRIPE_SHIPPING_TAX_CODE=txcd_92010001
# Set only after an operator confirms that not collecting retail tax is lawful
# for every enabled destination. Otherwise production quote creation fails.
PRINT_ALLOW_UNAVAILABLE_TAX=false

# HARD PRODUCTION GATES. Never set these merely to make a test pass. The Lulu
# acknowledgement means the sandbox checklist in docs/cookbook-printing.md has
# been completed and Lulu confirmed the documented normalization/cancel gaps.
PRINT_PRODUCTION_ENABLED=false
PRINT_LULU_VALIDATION_ACKNOWLEDGED=false
# Allows a deployed staff environment to use both Lulu sandbox + Stripe test.
PRINT_ALLOW_SANDBOX_IN_PRODUCTION=false

# Optional binary/font paths. Docker installs Poppler and bundles Space Mono.
# PDFTOPPM_PATH=/usr/bin/pdftoppm
# COOKBOOK_PRINT_FONT_PATH=/usr/src/app/apps/mobile/assets/fonts/SpaceMono-Regular.ttf

# ── Misc ────────────────────────────────────────────────────────────────────
NODE_ENV=development
# Bun serves on 3000 by default; the Makefile assumes that.
PORT=3000
