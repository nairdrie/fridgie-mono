# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native — Continuous Native Generation (CNG)
#
# Both native projects are generated by `expo prebuild` from app.json and the
# config plugins, so neither is tracked. Regenerate rather than edit:
#
#   npx expo prebuild --platform android --clean
#
# Never hand-edit anything under ios/ or android/ — the next prebuild discards
# it. Native config belongs in app.json, or in a config plugin (see how
# expo-build-properties sets ios.useFrameworks).
#
# Verified: prebuild reproduces every previously-committed android/ file
# byte-identically, including app/debug.keystore — so the debug signing SHA-1
# registered in Firebase for Google Sign-In is stable across regeneration.
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example
