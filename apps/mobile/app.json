{
  "expo": {
    "name": "fridgie",
    "slug": "fridgie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fridgie",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.nairdrie.fridgie",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F2317"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.nairdrie.fridgie",
      "permissions": [
        "android.permission.CAMERA"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.598650352064-t8n659ud33kd09jfagcas0akr8j0r3kj"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "776186408706339",
          "clientToken": "REPLACE_WITH_FACEBOOK_CLIENT_TOKEN",
          "displayName": "fridgie",
          "scheme": "fb776186408706339",
          "isAutoInitEnabled": false,
          "autoLogAppEventsEnabled": false,
          "advertiserIDCollectionEnabled": false,
          "iosUserTrackingPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fridgie uses your photos to import a recipe from a picture of one, and to add a photo to a recipe you save.",
          "cameraPermission": "Fridgie uses the camera to photograph a cookbook page or recipe card and read the recipe off it.",
          "microphonePermission": false
        }
      ],
      "expo-dev-client",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/adaptive-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F2317"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ff2fa424-615d-48a9-ad44-aefded9a7625"
      }
    }
  }
}
