# Build context is the REPO ROOT (see apps/api/Dockerfile), so this file — not
# apps/api/.dockerignore — is what Docker reads. Without it the context would
# include the mobile app's node_modules and native build output.

**/node_modules
.git
.gitignore
gha-creds-*.json

# The API image needs the cookbook's licensed print font, but no other mobile
# source or assets. Re-include that narrow directory for Dockerfile line 61.
apps/mobile/*
!apps/mobile/assets
apps/mobile/assets/*
!apps/mobile/assets/fonts
!apps/mobile/assets/fonts/**

# docker meta
**/Dockerfile*
**/docker-compose*
**/.dockerignore

# editors / os
.vscode
.idea
.DS_Store
.editorconfig

# secrets and local env
**/.env
**/.env.*
**/firebase-service-account.json

# docs, tests, coverage
**/README.md
LICENSE
**/coverage*
**/*.log
